# MongoDB : variables lues par config.py.
MONGODB_URI=mongodb+srv://votre-utilisateur:votre-mot-de-passe@votre-cluster.mongodb.net/
MONGODB_BASE=ferixu
# Identifiant de la plante dont ce Raspberry Pi publie les mesures.
PLANTE_ID=1

# MQTT (EMQX) : variables lues par config.py.
# Les topics sont définis dans config.py.
MQTT_HOTE=xxxxxxxx.ala.us-east-1.emqxsl.com
MQTT_PORT=8883
MQTT_UTILISATEUR=votre-utilisateur
MQTT_MOT_DE_PASSE=votre-mot-de-passe
