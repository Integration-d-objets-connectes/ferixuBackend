# MongoDB : variables lues par config.py.
MONGODB_URI=mongodb+srv://votre-utilisateur:votre-mot-de-passe@votre-cluster.mongodb.net/
MONGODB_BASE=nom-de-votre-base
MONGODB_COLLECTION_LUMIERE=Lumiere
MONGODB_COLLECTION_TEMPERATURE_HUMIDITE=Temperature_humidite
MONGODB_COLLECTION_ARROSAGE=Arrosage
MONGODB_COLLECTION_PLANTE=Plante
# Identifiant de la plante dont ce Raspberry Pi publie les mesures.
PLANTE_ID=1

# MQTT : variables prévues, pas encore lues par config.py.
# Le broker, le port et les topics sont actuellement définis dans le code.
BROKER=
PORT=
USERNAME=""
PASSWORD=
TOPIC=
